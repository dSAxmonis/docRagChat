# Server
PORT=3000
NODE_ENV=development

# Postgres with pgvector (docker compose exposes this locally)
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
# Set to true for managed Postgres that requires TLS
DATABASE_SSL=false

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the vector(N) column in server/src/migrations/001_init.sql
EMBED_DIM=768

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# Limits
CHAT_RATE_LIMIT_PER_MIN=20
MAX_UPLOAD_MB=5
