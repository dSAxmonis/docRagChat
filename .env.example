# Server
PORT=3000
NODE_ENV=development

# Postgres with pgvector: docker compose locally, Neon in production (pooled -pooler URL)
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
# Optional direct (non-pooled) URL used only for migrations. Neon: the URL without -pooler
DATABASE_URL_UNPOOLED=
# Set to true for managed Postgres that requires TLS
DATABASE_SSL=false

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Comma-separated chat models, tried in order when one is overloaded or retired
GEMINI_CHAT_MODELS=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the vector(N) column in server/src/migrations/001_init.sql
EMBED_DIM=768

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# Limits
CHAT_RATE_LIMIT_PER_MIN=20
MAX_UPLOAD_MB=5
